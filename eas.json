{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": { "EXPO_PUBLIC_APP_FLAVOR": "review" }
    },
    "review": {
      "distribution": "internal",
      "channel": "review",
      "env": { "EXPO_PUBLIC_APP_FLAVOR": "review" }
    },
    "beta": {
      "distribution": "internal",
      "channel": "beta",
      "env": { "EXPO_PUBLIC_APP_FLAVOR": "beta" }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_APP_FLAVOR": "production" }
    }
  },
  "submit": {
    "production": {}
  }
}
