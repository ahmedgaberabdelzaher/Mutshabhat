{
  "name": "mutshabhat",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/ui": "~58.0.29",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.32",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.22",
    "expo-web-browser": "~58.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "EXPO_PUBLIC_APP_FLAVOR=${EXPO_PUBLIC_APP_FLAVOR:-review} expo start",
    "android": "EXPO_PUBLIC_APP_FLAVOR=${EXPO_PUBLIC_APP_FLAVOR:-review} expo start --android",
    "ios": "EXPO_PUBLIC_APP_FLAVOR=${EXPO_PUBLIC_APP_FLAVOR:-review} expo start --ios",
    "web": "EXPO_PUBLIC_APP_FLAVOR=${EXPO_PUBLIC_APP_FLAVOR:-review} expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "build:data": "node scripts/build-quran-data.mjs && node scripts/build-mutashabihat-data.mjs",
    "start:production": "EXPO_PUBLIC_APP_FLAVOR=production expo start",
    "build:mutashabihat": "node scripts/build-mutashabihat-data.mjs",
    "check:production-bundle": "node scripts/check-production-bundle.mjs",
    "update:review": "EXPO_PUBLIC_APP_FLAVOR=review npx eas-cli@latest update --channel review",
    "update:production": "EXPO_PUBLIC_APP_FLAVOR=production npx eas-cli@latest update --channel production"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  }
}
